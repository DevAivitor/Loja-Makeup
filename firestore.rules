rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'vitorsori4@gmail.com' && request.auth.token.email_verified == true;
    }

    // Validation Helpers
    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'cat', 'desc', 'price', 'img', 'badge']) &&
             data.keys().size() == 6 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.cat is string && data.cat.size() > 0 && data.cat.size() <= 50 &&
             data.desc is string && data.desc.size() <= 500 &&
             data.price is number && data.price >= 0 &&
             data.img is string && data.img.size() <= 500 &&
             data.badge is string && data.badge.size() <= 20;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['date', 'items', 'total', 'status', 'customer', 'deliveryMethod']) &&
             data.date is string &&
             data.items is list && data.items.size() > 0 &&
             data.total is number &&
             data.status is string &&
             data.customer is string &&
             data.deliveryMethod is string;
    }

    function isValidStoreSettings(data) {
      return data.keys().hasAll(['name', 'slogan', 'phone', 'ig', 'password']) &&
             data.keys().size() == 5 &&
             data.name is string && data.name.size() <= 100 &&
             data.slogan is string && data.slogan.size() <= 200 &&
             data.phone is string && data.phone.size() <= 20 &&
             data.ig is string && data.ig.size() <= 100 &&
             data.password is string && data.password.size() <= 100;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'label', 'emoji']) &&
             data.keys().size() == 3 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 50 &&
             data.label is string && data.label.size() > 0 && data.label.size() <= 100 &&
             data.emoji is string && data.emoji.size() > 0 && data.emoji.size() <= 10;
    }

    // Rules
    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
      allow update: if isAdmin() && isValidId(productId) && isValidProduct(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'cat', 'desc', 'price', 'img', 'badge'])
      );
      allow delete: if isAdmin() && isValidId(productId);
    }

    match /orders/{orderId} {
      allow read: if isAdmin();
      allow create: if isValidId(orderId) && isValidOrder(incoming());
      allow update: if isAdmin() && isValidId(orderId) && isValidOrder(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['date', 'items', 'total', 'status', 'customer', 'deliveryMethod'])
      );
      allow delete: if isAdmin() && isValidId(orderId);
    }

    match /settings/{settingId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(settingId) && isValidStoreSettings(incoming());
      allow update: if isAdmin() && isValidId(settingId) && isValidStoreSettings(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'slogan', 'phone', 'ig', 'password'])
      );
      allow delete: if isAdmin() && isValidId(settingId);
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(categoryId) && isValidCategory(incoming());
      allow update: if isAdmin() && isValidId(categoryId) && isValidCategory(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'label', 'emoji'])
      );
      allow delete: if isAdmin() && isValidId(categoryId);
    }
  }
}
